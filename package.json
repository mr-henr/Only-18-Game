{
  "name": "noite-de-desafios",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "Jogo social adulto (18+) com dados, cartas parametricas e sistema de limites individuais.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node scripts/engine-check.mjs",
    "docs": "node scripts/gen-cards-doc.mjs",
    "server": "node server/index.js",
    "dev:tv": "concurrently -n vite,server -c cyan,magenta \"vite --host\" \"node server/index.js\"",
    "start": "npm run build && node server/index.js",
    "build:pages": "vite build --base=/Only-18-Game/"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "vite": "^7.1.5"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.21.3"
  },
  "homepage": "https://mr-henr.github.io/Only-18-Game/"
}
